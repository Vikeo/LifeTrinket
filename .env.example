# Grafana Faro (Frontend Observability) Configuration
# Get these values from: https://grafana.com/
# Navigate to: Frontend Observability → Create new app

# Faro collector URL (provided when you create a new Faro app)
# Example: https://faro-collector-prod-eu-north-0.grafana.net/collect/1139db07f05f357fa379eeab0549acb4
VITE_GRAFANA_FARO_URL=your-faro-collector-url-here

# Optional: Application name (defaults to 'LifeTrinket')
VITE_GRAFANA_FARO_APP_NAME=LifeTrinket

# Live game tracking, read by EventTrinket. Leave these empty to disable it.
VITE_TRACK_DATABASE_URL=
VITE_TRACK_PROJECT_ID=
VITE_TRACK_API_KEY=

# EventTrinket's address, for the "Back to event" button. Defaults to
# https://eventtrinket.com/. Point it at an EventTrinket dev server to test.
VITE_EVENTTRINKET_URL=
