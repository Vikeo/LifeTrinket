# The draft-trinket project hosts the shared tracking database. These values
# reach the browser inside the bundle, so none of them is a secret. The rules
# in EventTrinket/database.rules.json control access.
VITE_TRACK_DATABASE_URL=https://draft-trinket-default-rtdb.europe-west1.firebasedatabase.app
VITE_TRACK_PROJECT_ID=draft-trinket
# Empty on purpose. Fill in the draft-trinket web API key when the live
# database is created. Until then isTrackingConfigured() is false, so a
# production build never opens a connection and never writes a node.
VITE_TRACK_API_KEY=AIzaSyA4P38sIy4GE-OGINDM3aHwTVVWozgr4nQ

# Where "Back to event" sends a player. eventHub.ts carries the same value as
# a fallback, and a test asserts that the two agree.
VITE_EVENTTRINKET_URL=https://eventtrinket.com/
